# === Telegram Bot Token ===
# Get it from @BotFather in Telegram
BOT_TOKEN=your_bot_token_here

# === Proxy (for regions where Telegram API is blocked, e.g. http://127.0.0.1:12334) ===
PROXY_URL=

# === Database ===
# SQLite (default, for development):
DATABASE_URL=sqlite+aiosqlite:///./data/media_bot.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/media_bot

# === Directories ===
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp

# === Limits ===
MAX_CONCURRENT_DOWNLOADS=2
MAX_USER_QUEUE=20
MAX_FILE_SIZE_MB=2048
TELEGRAM_FILE_LIMIT_MB=50

# === Admins (comma-separated Telegram IDs) ===
ADMIN_IDS=123456789,987654321

# === FFmpeg path (leave empty if ffmpeg is in PATH) ===
FFMPEG_PATH=

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
